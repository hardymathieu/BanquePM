{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "banque-papa-maman",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "DB", "database_name": "banque-papa-maman", "migrations_dir": "migrations" }
  ],
  // Log nothing: no Workers Logs, no traces, no Logpush. Never turn this on.
  "observability": { "enabled": false },
  "logpush": false
}
