# Static asset headers (Workers static assets). The API sets its own headers.
/*
  Content-Security-Policy: default-src 'self'; connect-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()

# The service worker must always be revalidated, so updates reach every phone.
/sw.js
  Cache-Control: no-cache
